umask 077

tempdir="${XDG_CACHE_HOME:-"$HOME/.cache"}/mutt-wizard/files"
# The PID prefix keeps two attachments with the same basename from
# overwriting each other in the cache.
file="$tempdir/$$-${1##*/}"
mkdir -p "$tempdir" || exit 1
cp -f "$1" "$file" || exit 1

# Pick a file opener. $OPENER overrides everything and may contain command
# arguments (for example "firefox --new-window"); it is split on whitespace,
# so use a wrapper script if an argument itself contains spaces. macOS has its
# own `open` command; on Linux and OpenBSD xdg-open (x11/xdg-utils) is
# preferred with gio and open as fallbacks. setsid(1) is a Linux-only
# utility, so nohup(1) (which is POSIX) is used to detach instead.
if [ -n "$OPENER" ]; then
	set -f
	set -- $OPENER
	set +f
	opener="$1"
	shift
	command -v "$opener" >/dev/null 2>&1 ||
		{ echo "mutt-wizard: cannot run OPENER: $OPENER" >&2; exit 1; }
else
	case "$(uname -s)" in
		Darwin) opener="open" ;;
		*) opener="xdg-open" ;;
	esac
	command -v "$opener" >/dev/null 2>&1 || {
		opener=""
		for candidate in xdg-open gio open; do
			command -v "$candidate" >/dev/null 2>&1 && { opener="$candidate"; break; }
		done
	}
	[ -n "$opener" ] || { echo "mutt-wizard: no opener found (xdg-open, gio, or open)." >&2; exit 1; }
	set --
fi

case "${opener##*/}" in
	gio)
		if [ "$#" -eq 0 ] || [ "$1" != "open" ]; then
			set -- "$opener" open "$@"
		else
			set -- "$opener" "$@"
		fi
		;;
	*) set -- "$opener" "$@" ;;
esac
set -- "$@" "$file"
nohup "$@" >/dev/null 2>&1 &
# -delete is not POSIX; -exec rm is available everywhere.
find "${tempdir:?}" -mtime +1 -type f -exec rm -f {} + 2>/dev/null || :
