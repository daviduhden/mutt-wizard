#!/bin/sh

# - Syncs mail for all accounts, or a single account given as an argument.
# - Displays a notification showing the number of new mails.
# - Displays a notification for each new mail with its subject displayed.
# - Runs notmuch to index new mail.
# - This script can be set up as a cron job for automated mail syncing.

# This script is POSIX sh and runs on Linux, macOS and OpenBSD. It avoids
# Linux-specific utilities so that it can be installed as a cron job on
# OpenBSD as well (OpenBSD cron runs commands with a restricted environment).

# Copyright (C) 2018-2026 Luke Smith
# Copyright (C) 2025-2026 David Uhden Collado
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <http://www.gnu.org/licenses/>.

# Ensure commands installed under the local prefix (typically /usr/local,
# where OpenBSD ports and mutt-wizard itself live) and this script's own
# directory are on PATH even when run from a restricted cron environment.
# This is done explicitly because cron does not source shell startup files.
case "$0" in
	/*) bindir="${0%/*}" ;;
	*) bindir="" ;;
esac
for d in "$bindir" /usr/local/bin; do
	[ -n "$d" ] || continue
	case ":$PATH:" in
		*:"$d":*) ;;
		*) PATH="${PATH:+$PATH:}$d" ;;
	esac
done
export PATH

# Hold an atomic lock for the whole run. The pgrep check below only covers
# external mbsync/mpop processes; this lock also prevents two mailsync runs
# from overlapping in the notification/notmuch phase.
lockbase="${XDG_CACHE_HOME:-$HOME/.cache}/mutt-wizard"
lockdir="$lockbase/mailsync.lock"
mkdir -p "$lockbase" 2>/dev/null || exit 1
if ! mkdir "$lockdir" 2>/dev/null; then
	lockpid="$(sed -n '1p' "$lockdir/pid" 2>/dev/null)"
	if [ -n "$lockpid" ] && kill -0 "$lockpid" 2>/dev/null; then
		echo "mailsync is already running." >&2
		exit
	fi
	rm -rf "$lockdir" 2>/dev/null
	mkdir "$lockdir" 2>/dev/null || { echo "Could not acquire the mailsync lock." >&2; exit 1; }
fi
printf '%s\n' "$$" >"$lockdir/pid"
trap 'rm -rf "$lockdir"' EXIT
trap 'rm -rf "$lockdir"; exit 1' HUP INT TERM

# Run only if not already running in other instance. Restrict the match to
# this user so that another user's mbsync on a shared machine does not block
# the sync, and skip the check silently if pgrep is unavailable.
if command -v pgrep >/dev/null 2>&1; then
	for running in mbsync mpop; do
		if pgrep -u "$(id -u)" "$running" >/dev/null 2>&1; then
			echo "$running is already running." >&2
			exit
		fi
	done
fi

# First, we have to get the right variables for the mbsync file, the pass
# archive, notmuch and the GPG home. This is done by searching common profile
# files for variable assignments. This is ugly, but there are few options that
# will work on the maximum number of machines.
#
# profilevar LINE
# Parse one whitelisted assignment without executing arbitrary profile code.
# Command substitutions, separators, redirections and unbalanced quotes are
# ignored. This is intentionally less capable than a shell parser, but cron
# runs it unattended.
profilevar() {
	line="$(printf '%s' "$1" |
		sed -e 's/^[[:space:]]*//' -e 's/^export[[:space:]][[:space:]]*//')"
	case "$line" in
	MBSYNCRC=*|MPOPRC=*|PASSWORD_STORE_DIR=*|PASSWORD_STORE_GPG_OPTS=*|NOTMUCH_CONFIG=*|GNUPGHOME=*|MAILSYNC_MUTE=*|XDG_CONFIG_HOME=*|XDG_DATA_HOME=*) ;;
	*) return 0 ;;
	esac
	case "$line" in
	*'`'*|*'$('*|*';'*|*'&'*|*'|'*|*'<'*|*'>'*|*'('*|*')'*) return 0 ;;
	esac
	printf '%s\n' "$line" | awk -v sqc="'" '{
		dq = 0; sq = 0;
		for (i = 1; i <= length($0); i++) {
			c = substr($0, i, 1);
			if (c == "\"" && !sq) dq = !dq;
			else if (c == sqc && !dq) sq = !sq;
		}
		exit (dq || sq);
	}' || return 0
	eval "export $line" 2>/dev/null || :
}

# Export the reconstructed values: an assignment without `export` would not
# reach gpg, pass, mbsync or notmuch, which run as child processes.
set -a
for profile in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.zprofile" \
	"$HOME/.config/zsh/.zprofile" "$HOME/.zshenv" \
	"$HOME/.config/zsh/.zshenv" "$HOME/.bashrc" "$HOME/.zshrc" \
	"$HOME/.config/zsh/.zshrc"; do
	[ -f "$profile" ] || continue
	while IFS= read -r line; do
		profilevar "$line"
	done <"$profile"
done
set +a
# $HOME/.pam_environment is deliberately not parsed here: its syntax
# ("NAME DEFAULT=value", "@{HOME}") is not shell syntax and eval would turn
# it into literal or malformed paths. Use a shell profile for these settings.

# Resolve gpg/gpg2 like `mw` does. On systems where only gpg2 exists, a
# hard-coded `gpg` would make every cron run fail before syncing.
GPG="$(command -v gpg 2>/dev/null || command -v gpg2 2>/dev/null || true)"

# For a non-interactive shell (e.g. a cron job) run only when the GPG key that
# protects the pass store is unlocked. Probe a real pass entry when one exists
# rather than the unrelated default signing key.
if ! tty -s; then
	if [ -n "$GPG" ]; then
		store="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
		probe="$(find "$store" -type f -name '*.gpg' 2>/dev/null | sed -n '1p')"
		if [ -n "$probe" ]; then
			"$GPG" --batch --decrypt "$probe" >/dev/null 2>&1 || exit
		else
			echo "dummy" | "$GPG" --sign --batch -o /dev/null >/dev/null 2>&1 || exit
		fi
	fi
fi

# Only set GPG_TTY when stdin really is a terminal; `tty` prints
# "not a tty" to stdout when it is not, which must not end up in GPG_TTY.
if tty -s; then
	GPG_TTY="$(tty)"
	export GPG_TTY
fi

# mbsync reads its configuration from ~/.mbsyncrc or via -c; there is no
# MBSYNCRC environment variable, so wrap it in a shell function (an alias
# would not be expanded by all /bin/sh implementations in non-interactive
# mode). mpop honors neither an MPOPRC environment variable, so pass the
# configuration file explicitly with -C.
MBSYNCRC="${MBSYNCRC:-$HOME/.mbsyncrc}"
# Keep the default in sync with `mw`, which writes the POP configuration to
# $XDG_CONFIG_HOME/mpop/config (falling back to ~/.config). Ignoring
# $XDG_CONFIG_HOME here would make mpop read a non-existent file.
MPOPRC="${MPOPRC:-${XDG_CONFIG_HOME:-"$HOME/.config"}/mpop/config}"
mbsync() { command mbsync -c "$MBSYNCRC" "$@"; }
mpop() { command mpop -C "$MPOPRC" "$@"; }

lastrun="${XDG_CONFIG_HOME:-"$HOME/.config"}/mutt/.mailsynclastrun"
# Make sure the reference file exists so that `find -newer' works on the very
# first run. An epoch timestamp makes freshly downloaded mail count as new
# (a single summary notification, not one per message).
[ -f "$lastrun" ] || { mkdir -p "${lastrun%/*}"; touch -t 197001010000 "$lastrun"; }

# Settings are different for MacOS (Darwin) systems.
os="$(uname -s)"

# Decide how to send desktop notifications. This is entirely optional; mail
# synchronization works without it. notify-send is looked up dynamically
# (OpenBSD ships it in x11/libnotify, not in the base system).
command -v notify-send >/dev/null 2>&1 && HAVE_NOTIFYSEND=1
displays=""
case "$os" in
	Darwin)
		# macOS notifications go through osascript.
		;;
	*)
		# Linux (X11/XWayland) and OpenBSD (Xenocara) both create their
		# X server sockets in /tmp/.X11-unix, so this works without
		# Linux-specific process listings. Wayland-only Linux desktops
		# without XWayland simply skip notifications; sync still works.
		[ -d /tmp/.X11-unix ] && displays="$(cd /tmp/.X11-unix 2>/dev/null && for x in X*; do [ -S "$x" ] && echo ":${x#X}"; done)"
		;;
esac

# If no DBUS session bus address is exported (common under cron), use the
# user's session bus socket if one exists. On OpenBSD there is no
# /run/user by default; users there get the address from their own
# environment instead, and we only override it when a socket really exists.
if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
	if [ -n "$XDG_RUNTIME_DIR" ] && [ -S "$XDG_RUNTIME_DIR/bus" ]; then
		DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
	elif [ -S "/run/user/$(id -u)/bus" ]; then
		DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
	fi
	[ -n "$DBUS_SESSION_BUS_ADDRESS" ] && export DBUS_SESSION_BUS_ADDRESS
fi

notify() { # $1 = title, $2 = body
	case "$os" in
		Darwin)
			# Escape backslashes and double quotes so that a crafted
			# subject/sender cannot break out of the AppleScript string.
			nbody="$(printf '%s' "$2" | sed 's/\\/\\\\/g; s/"/\\"/g')"
			ntitle="$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
			osascript -e "display notification \"$nbody\" with title \"$ntitle\"" >/dev/null 2>&1
			;;
		*)
			[ -n "$HAVE_NOTIFYSEND" ] || return 0
			[ -n "$displays" ] || displays=":0"
			for x in $displays; do
				# Errors (e.g. no D-Bus session) are expected under
				# cron; keep them out of the cron mail.
				DISPLAY="$x" notify-send --app-name="mutt-wizard" -- "$1" "$2" >/dev/null 2>&1
			done
			;;
	esac
}

# Check account for new mail. Notify if there is new content.
# The function's status reports the sync, not the presentation: under cron
# there is no tty, notify-send may be absent, and MAILSYNC_MUTE may be set.
syncandnotify() {
	case "$1" in
		imap) mbsync -q "$2" ;;
		pop) mpop -q "$2" ;;
	esac || return 1
	new=$(find\
		"$maildir/$2/"[Ii][Nn][Bb][Oo][Xx]/new/ \
		"$maildir/$2/"[Ii][Nn][Bb][Oo][Xx]/cur/ \
		-type f -newer "$lastrun" 2> /dev/null)
	newcount=$(printf '%s\n' "$new" | sed '/^[[:space:]]*$/d' | wc -l)
	if [ -z "$MAILSYNC_MUTE" ]; then
		# shellcheck disable=SC2194
		# (the arithmetic expansion in the case pattern is intentional)
		case 1 in
			$((newcount > 5)) )
				tty -s 2>/dev/null && echo "$newcount new mails for $2." >/dev/tty
				notify "New Mail!" "📬 $newcount new mails in \`$2\` account."
				;;
			$((newcount > 0)) )
				tty -s 2>/dev/null && echo "$newcount new mail(s) for $2." >/dev/tty
				# Disable pathname expansion: a maildir name may contain
				# glob characters.
				set -f
				for file in $new; do
					# Stop at the header/body separator so body lines
					# such as "Note: ..." never become the subject.
					subject=$(awk '
						/^[[:space:]]*$/ { exit }
						tolower($0) ~ /^subject:/ {
							sub(/^[^:]*:[[:space:]]*/, "")
							print
							exit
						}
					' "$file" |
						perl -CS -MEncode -ne 'print decode("MIME-Header", $_)' |
						tr -d '\n\t')
					from="$(sed -n "/^From:/ s|From: *|| p" "$file" |
						perl -CS -MEncode -ne 'print decode("MIME-Header", $_)')"
					from="${from% *}" ; from="${from%\"}" ; from="${from#\"}"
					notify "📧$from:" "$subject"
				done
				set +f
				;;
			# Keep this off stdout as well: the cron job captures stdout and
			# would otherwise e-mail "No new mail" on every single run.
			*) tty -s 2>/dev/null && echo "No new mail for $2." >/dev/tty ;;
		esac
	fi
	return 0
}

maildir="${XDG_DATA_HOME:-"$HOME/.local/share"}/mail"

allaccounts="$(grep -Ehs "^(Channel|account)" "$MBSYNCRC" "$MPOPRC" 2>/dev/null)"

# Get accounts to sync. All if no argument. Prefix with `error` if non-existent.
IFS='
'
if [ -z "$1" ]; then
	tosync="$allaccounts"
else
	tosync=""
	for arg in "$@"; do
		found=""
		for availacc in $allaccounts; do
			if [ "$arg" = "${availacc##* }" ]; then
				tosync="${tosync}${tosync:+
}${availacc}"
				found=1
				break
			fi
		done
		if [ -z "$found" ]; then
			tosync="${tosync}${tosync:+
}error $arg"
		fi
	done
fi

pids=      # PIDs of backgrounded subshells
count=0    # number of accounts in $tosync
failed=0   # number of failed sync attempts
for account in $tosync; do
	count=$((count+1))
	case $account in
		Channel*)
			syncandnotify imap "${account##* }" &
			pids="$pids $!"
			;;
		account*)
			syncandnotify pop "${account##* }" &
			pids="$pids $!"
			;;
		error*)
			echo "ERROR: Account ${account##* } not found." >&2
			failed=$((failed+1))
			;;
	esac
done

IFS=' '
for pid in $pids; do
	# shellcheck disable=SC2086
	# ($pid is a single word from the controlled $pids list)
	wait $pid || failed=$((failed+1))
done

# Abort if no account sync succeeded
[ "$count" -gt "$failed" ] || exit 1

if command -v notmuch >/dev/null 2>&1; then
	notmuch new --quiet || :
fi

# Advance the reference timestamp only when every requested account succeeded.
# A partial failure must not hide mail that a failed account never counted.
if [ "$failed" -eq 0 ]; then
	mkdir -p "${lastrun%/*}"
	touch "$lastrun"
else
	exit 1
fi
